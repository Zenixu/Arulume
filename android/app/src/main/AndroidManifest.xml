<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ATURAN MUTLAK (Docs/AGENTS.md #1): JANGAN menambahkan izin INTERNET.
      Aplikasi harus berfungsi 100% offline. Capacitor menyajikan aset dari
      assets/public di dalam proses, jadi tidak butuh jaringan.
      Verifikasi: aapt dump permissions app-release.apk  → INTERNET tidak muncul.
      Kalau UI gagal dimuat tanpa izin ini, itu risiko R6 di PRD — lapor, jangan
      diam-diam menambah izinnya.
    -->

    <!-- Vulkan opsional: APK tetap bisa dipasang di HP tanpa Vulkan (fallback CPU) -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.compute"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Izin:
      - INTERNET: DIHAPUS (offline total).
      - READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE: tidak dipakai (Photo Picker/SAF).
      - WRITE_EXTERNAL_STORAGE: hanya untuk Android 9 ke bawah (simpan ke galeri).
      - Fase 2: FOREGROUND_SERVICE, WAKE_LOCK, POST_NOTIFICATIONS.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
