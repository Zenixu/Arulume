<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET — SATU-SATUNYA pemakaian yang diizinkan (Docs/AGENTS.md #1,
      pengecualian 2026-10-31 atas permintaan pemilik proyek): memeriksa dan
      mengunduh APK pembaruan dari halaman rilis resmi
      https://github.com/Zenixu/Arulume/releases. Tidak ada analitik, pelacakan,
      iklan, crash reporter, atau unggahan data pengguna. Pemrosesan foto/video
      tetap 100% offline. Jangan menambah pemakaian jaringan lain.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Memasang APK pembaruan yang sudah diunduh (Android 8+). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Vulkan opsional: APK tetap bisa dipasang di HP tanpa Vulkan (fallback CPU) -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.compute"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          Layanan latar untuk proses perbesar foto: pekerjaan tetap jalan saat
          aplikasi ditinggal / layar mati. Tanpa jaringan, tanpa Firebase.
        -->
        <service
            android:name=".EnhancerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Izin:
      - INTERNET: hanya untuk cek & unduh pembaruan dari GitHub Releases.
      - READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE: tidak dipakai (Photo Picker/SAF).
      - WRITE_EXTERNAL_STORAGE: hanya untuk Android 9 ke bawah (simpan ke galeri).
      - FOREGROUND_SERVICE (+ DATA_SYNC di Android 14+), WAKE_LOCK,
        POST_NOTIFICATIONS: hanya untuk layanan proses latar + notifikasi
        progres lokal. Tidak satu pun membuka akses jaringan.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
