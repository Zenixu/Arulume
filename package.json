{
  "name": "arulume",
  "version": "0.0.1",
  "private": true,
  "description": "Arulume — aplikasi Android offline untuk memperjelas dan memperbesar foto",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
